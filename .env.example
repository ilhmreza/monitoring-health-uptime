# ============================================================
#  UptimeBot - environment configuration
#
#  Copy to `.env` and fill in. NEVER commit `.env`.
#      cp .env.example .env
#
#  HOW SECRETS WORK HERE
#  ---------------------
#  Four values are credentials: the Discord webhook URL, the Discord bot
#  token, the UI password hash and the session key. Each has two ways to be
#  supplied:
#
#    1. THE VALUE DIRECTLY      DISCORD_WEBHOOK_URL=...
#    2. A POINTER TO A FILE     DISCORD_WEBHOOK_URL_FILE=/run/secrets/...
#
#  Use form 2 with the bundled docker-compose.yml. It mounts a real file from
#  ./secrets/ as a read-only Docker secret, so the value never lands in this
#  file, in `docker inspect` output, or in an env dump. install.sh sets form 2
#  up for you.
#
#  Do not paste a bcrypt hash into form 1 in a compose .env: docker compose
#  interpolates `$`, so `$2b$12$...` is mangled and every login then fails with
#  a hash that looks correct but is not.
# ============================================================

# ---------- Discord: reporting ----------
# Server Settings > Integrations > Webhooks > New Webhook > Copy URL
# Format: https://discord.com/api/webhooks/<id>/<token>
#
# The token after the last slash is a credential: anyone holding it can post.
# Recommended: leave the line below empty and write the URL to
# ./secrets/discord_webhook instead.
DISCORD_WEBHOOK_URL=
DISCORD_WEBHOOK_URL_FILE=/run/secrets/discord_webhook

# Channel ID for the reports (right-click channel > Copy ID with
# Developer Mode ON). Used to render <#channel_id> jump links and to pick which
# channel history the @username resolver reads. Not a secret.
DISCORD_REPORT_CHANNEL_ID=

# ---------- Discord: @username -> User ID resolution ----------
# A webhook cannot look up members. A bot token is used ONLY to turn
# "@someone" into a numeric User ID for a notification target. Leave all three
# empty to disable auto-resolve; the UI then falls back to manual ID input.
#
# Setup: https://discord.com/developers/applications > New Application
#   1. Bot menu > Reset Token > copy   (shown once)
#   2. OAuth2 > URL Generator > scope `bot`, permissions
#      View Channel + Read Message History  (integer 66560)
#   3. Open the invite URL to actually add the bot to the server
#
# The token is a credential. Recommended: write it to ./secrets/discord_bot_token.
DISCORD_BOT_TOKEN=
DISCORD_BOT_TOKEN_FILE=/run/secrets/discord_bot_token
DISCORD_GUILD_ID=

# ---------- Web UI: authentication ----------
UI_USERNAME=admin

# The password itself is never stored, only its bcrypt hash.
#   python -m uptimebot hash-password
# Recommended: write the hash to ./secrets/ui_password_hash
UI_PASSWORD_HASH=
UI_PASSWORD_HASH_FILE=/run/secrets/ui_password_hash

# Session signing key.
#   python -m uptimebot genkey
# Rotating it invalidates every active session.
SECRET_KEY=
SECRET_KEY_FILE=/run/secrets/secret_key

# ---------- Web server ----------
# The bundled compose file exposes no app port on purpose: Caddy is the only
# way in, so the UI is never reachable over plain HTTP.
BIND_HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# ---------- Public hostname ----------
# The name Caddy issues the TLS certificate for. Its DNS A/AAAA record must
# already point at this host, or issuance fails and the site never comes up.
PUBLIC_HOST=monitor.example.com

# Must match the host part of PUBLIC_HOST. Used for the HTTPS origin and for
# absolute links inside Discord embeds.
PUBLIC_URL=https://monitor.example.com

# Contact address for the ACME account. Required for real issuance: Let's
# Encrypt rejects placeholder domains such as example.com outright
# ("invalidContact ... forbidden domain"), and the site then serves no
# certificate at all. Use an address you actually read.
ACME_EMAIL=

# Note on port 80: ACME normally proves control over a name using the
# HTTP-01 challenge, which needs inbound port 80. If your host cannot publish
# 80, Caddy must fall back to the TLS-ALPN-01 challenge on 443.

# ---------- Cloudflare Tunnel (no inbound ports) ----------
# Use this when the host is unreachable from the internet entirely: no public
# IP, and no port forwarded to it. cloudflared opens an outbound connection to
# Cloudflare and Cloudflare routes the public hostname down it, so nothing has
# to be published and Caddy never talks to Let's Encrypt.
#
# Point the tunnel's Public Hostname at the host port Caddy is published on
# (443 by default, or the port in docker-compose.override.yml if 443 is taken),
# e.g. service https://localhost:7443. Then set the line below to
# ./Caddyfile.cloudflared, which serves a single localhost site with Caddy's
# internal CA and reads the visitor IP from CF-Connecting-IP. ACME_EMAIL is
# unused in this mode; see the README "Cloudflare Tunnel" section for making
# cloudflared trust the internal CA.
CADDYFILE=./Caddyfile

# ---------- Behaviour ----------
TZ=Asia/Jakarta

# Default probe settings; individual monitors may override them.
DEFAULT_INTERVAL_SECONDS=60
DEFAULT_TIMEOUT_SECONDS=10

# Consecutive failures required before alerting (anti-flap).
DEFAULT_FAILURE_THRESHOLD=3

# How often to re-ping the PIC while a monitor is still down.
REMINDER_INTERVAL_MINUTES=30

# SSL expiry warning thresholds, in days, most severe last.
SSL_WARN_DAYS=30,14,7,1

# How often the certificate itself is re-fetched.
SSL_CHECK_INTERVAL_SECONDS=21600

# Delete check history older than this many days.
RETENTION_DAYS=30

# ---------- Security ----------
# Master switch for outbound URL protection.
#
# When false (recommended): probes to loopback / private / link-local /
# cloud-metadata addresses are refused, unless a monitor explicitly sets
# allow_private_network=true. This blocks SSRF against internal services and
# cloud metadata endpoints entered through the web UI.
#
# Set true only if you exclusively monitor internal services and want the
# warnings gone.
ALLOW_PRIVATE_NETWORK=false

# Login throttling.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=300

# Set true when the app is served over HTTPS so the session cookie gets the
# Secure flag. Caddy terminates TLS, so with the bundled docker-compose.yml
# this should be true.
COOKIE_SECURE=true

# Trust X-Forwarded-For when keying the login throttle per client IP.
# Safe ONLY behind a proxy that replaces the header (the bundled Caddyfile
# does). With it off, the app sees only the proxy's address, so every visitor
# shares one throttle bucket and a single attacker can lock the admin out
# indefinitely by deliberately burning the attempt budget.
TRUST_PROXY=true
# Secrets — never commit
.env
.env.*
!.env.example

# Secret files mounted as Docker secrets. The directory is kept in the repo so
# the layout is obvious, but the values inside are the credentials.
#
# The ignore has to be "secrets/*" rather than "secrets/": git will not descend
# into an excluded directory, so "!" on a file inside it can never win.
secrets/*
!secrets/.gitkeep

# Local TLS trust anchor exported from the dev container. Public key material,
# but it is per-machine and must never be part of a deployment.
caddy-local-ca.crt
*.crt
*.pem
*.key

# Runtime data (SQLite)
data/
*.db
*.db-wal
*.db-shm

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Generated by install.sh: it re-adds the port 80 mapping that Linux can afford
# and Windows cannot. Machine-specific, so it is not part of the repository.
docker-compose.override.yml

# Caddy (TLS material at deploy time, not at dev time)
caddy_data/
caddy_config/